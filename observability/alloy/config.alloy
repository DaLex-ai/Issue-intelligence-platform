discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=" + sys.env("IIP_COMPOSE_PROJECT")]
  }
}
discovery.relabel "iip" {
  targets = discovery.docker.local.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "app|batch|worker"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
}
loki.source.docker "iip" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.iip.output
  forward_to = [loki.process.iip.receiver]
}
loki.process "iip" {
  stage.json {
    expressions = { service = "service", level = "level", env = "env" }
  }
  stage.labels {
    values = { service = "", level = "", env = "" }
  }
  stage.label_keep {
    values = ["service", "level", "env"]
  }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

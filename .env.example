POSTGRES_DB=issue_intelligence
POSTGRES_USER=issue_app
POSTGRES_PASSWORD=replace_me

MLFLOW_DB=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=replace_me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_me
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# RabbitMQ backpressure and inference worker settings
RABBIT_MAX_LENGTH=20
ENABLE_BACKPRESSURE=true
WORKER_CONCURRENCY=2
WORKER_PREFETCH_COUNT=2
INFERENCE_DELAY_SECONDS=0.5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY_SECONDS=0.25
API_PUBLISH_SLOTS=4
# 0=derive from queue length/concurrency/latency
API_RETRY_AFTER_SECONDS=0
BATCH_BACKOFF_MIN_SECONDS=0.05
BATCH_BACKOFF_MAX_SECONDS=1.0

# Abandoned admissions are cancelled, not replayed.
PUBLICATION_TIMEOUT_SECONDS=30
PUBLICATION_RECONCILE_SECONDS=5
PUBLISHER_CONFIRM_TIMEOUT=2
WORKER_CLAIM_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
API_OPERATION_TIMEOUT_SECONDS=5

# Observability is opt-in. Enable OTLP when the Collector is running.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
LOG_LEVEL=INFO
IIP_ENV=local
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=local-observe
ALLOY_VERSION=v1.8.3
LOKI_VERSION=3.4.3
TEMPO_VERSION=2.7.2
OTEL_COLLECTOR_VERSION=0.128.0
PROMETHEUS_VERSION=v3.3.0
GRAFANA_VERSION=11.6.0

POSTGRES_DB=issue_intelligence
POSTGRES_USER=issue_app
POSTGRES_PASSWORD=replace_me

MLFLOW_DB=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=replace_me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_me
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# RabbitMQ backpressure and inference worker settings
RABBIT_MAX_LENGTH=20
ENABLE_BACKPRESSURE=true
WORKER_CONCURRENCY=2
WORKER_PREFETCH_COUNT=2
INFERENCE_DELAY_SECONDS=0.5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY_SECONDS=0.25
API_PUBLISH_SLOTS=4
# 0=derive from queue length/concurrency/latency
API_RETRY_AFTER_SECONDS=0
BATCH_BACKOFF_MIN_SECONDS=0.05
BATCH_BACKOFF_MAX_SECONDS=1.0
